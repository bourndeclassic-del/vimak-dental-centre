                                <i class="bi bi-people-fill"></i>
                                <h5 class="fw-bold mt-2">Commitment to Dental Education</h5>
                                <p class="text-muted small mb-0">
                                    Both in the clinic chair and through our educational social channels, our team shares practical tips to help you protect your smile every day.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

