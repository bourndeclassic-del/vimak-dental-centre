                        <div class="team-card">
                            <div class="team-avatar-placeholder" aria-hidden="true">
                                <i class="bi bi-stars"></i>
                            </div>
                            <span class="client-confirm-tag mb-2">[CLIENT TO CONFIRM]</span>
                            <h5 class="mt-1 fw-bold">Oral Hygiene &amp; Preventive Care Team</h5>
                            <p class="text-muted small mb-3">
                                Professional scaling, polishing, fluoride care, and patient education to help children and adults maintain healthy teeth and gums.
                            </p>
                            <span class="small fw-semibold text-primary mt-auto">Profile &amp; Qualifications Coming Soon</span>
                        </div>
                    </div>

                    <!-- Role Placeholder 3 -->
