                                            <i class="bi bi-envelope-fill text-primary me-2"></i>
                                            <strong>Email:</strong>
                                            <a href="mailto:info@vimakdentalcentre.co.ke" class="text-decoration-none text-primary">info@vimakdentalcentre.co.ke</a>
                                        </li>
                                        <li class="mb-2">
                                            <i class="bi bi-clock-fill text-primary me-2"></i>
                                            <strong>Monday–Saturday:</strong> 8:00 AM – 8:00 PM
                                        </li>
                                        <li class="mb-0">
                                            <i class="bi bi-clock-fill text-primary me-2"></i>
                                            <strong>Sunday:</strong> 8:00 AM – 5:00 PM
