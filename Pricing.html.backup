            <!-- Book Appointment & Clinic Contact Section -->
            <section class="py-5" style="background: #EAF3FA;" id="book-appointment">
                <div class="container">
                    <div class="text-center mb-5">
                        <span class="section-tag">Schedule Your Visit</span>
                        <h2 class="fw-bold">Book an Appointment or Contact Our Clinics</h2>
                        <p class="section-subtitle">
                            Complete the form below to request an appointment, or reach our Nairobi and Thika branches directly.
                        </p>
                    </div>

                    <div class="row g-4 align-items-start">
                        <!-- Appointment Form -->
                        <div class="col-lg-7">
                            <div class="booking-card">
                                <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                                    <h4 class="fw-bold mb-0">Book An Appointment</h4>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                                        <i class="bi bi-whatsapp"></i> Direct Reception Request
                                    </span>
                                </div>
                                <p class="text-muted small mb-4">
                                    Note: Submitting this form prepares your appointment request via WhatsApp or Email. Our reception team will respond to confirm your appointment slot.
                                </p>

                                <form id="vimakAppointmentForm">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label for="appFullName" class="form-label fw-semibold small">Full Name *</label>
                                            <input type="text" id="appFullName" class="form-control form-field"
                                                placeholder="Enter your full name" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="appPhone" class="form-label fw-semibold small">Phone Number *</label>
                                            <input type="tel" id="appPhone" class="form-control form-field"
                                                placeholder="e.g. 0720 285 819" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="appEmail" class="form-label fw-semibold small">Email</label>
                                            <input type="email" id="appEmail" class="form-control form-field"
                                                placeholder="yourname@example.com">
                                        </div>

                                        <div class="col-md-6">
                                            <label for="appLocation" class="form-label fw-semibold small">Preferred Location *</label>
                                            <select id="appLocation" class="form-select form-field" required>
                                                <option value="Nairobi Clinic — ICEA Building (JKUAT Towers), 2nd Floor">Nairobi — ICEA Building (JKUAT Towers), 2nd Floor</option>
                                                <option value="Thika Clinic — Maisha Heights Building, Ground Floor">Thika — Maisha Heights Building, Ground Floor</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="appDate" class="form-label fw-semibold small">Preferred Date *</label>
                                            <input type="date" id="appDate" class="form-control form-field" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label for="appTime" class="form-label fw-semibold small">Preferred Time *</label>
                                            <select id="appTime" class="form-select form-field" required>
                                                <option value="Morning (8:00 AM - 12:00 PM)">Morning (8:00 AM – 12:00 PM)</option>
                                                <option value="Afternoon (12:00 PM - 4:00 PM)">Afternoon (12:00 PM – 4:00 PM)</option>
                                                <option value="Evening (4:00 PM - 8:00 PM, Mon-Sat)">Evening (4:00 PM – 8:00 PM, Mon–Sat)</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="appService" class="form-label fw-semibold small">Service / Reason for Visit *</label>
                                            <select id="appService" class="form-select form-field" required>
                                                <option value="General Dental Checkup & Consultation">General Dental Checkup &amp; Consultation</option>
                                                <option value="Root Canal Treatment">Root Canal Treatment</option>
                                                <option value="Oral Hygiene (Scaling & Polishing)">Oral Hygiene (Scaling &amp; Polishing)</option>
                                                <option value="Crowns, Bridges & Dentures">Crowns, Bridges &amp; Prosthetics</option>
                                                <option value="Dental Implants Consultation">Dental Implants Consultation</option>
                                                <option value="Children's Dentistry">Children's Dentistry</option>
                                                <option value="Orthodontics (Braces)">Orthodontics (Braces)</option>
                                                <option value="Toothache / Urgent Dental Assessment">Toothache / Urgent Dental Assessment</option>
                                                <option value="Treatment Pricing Inquiry">Treatment Pricing Inquiry</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label for="appMessage" class="form-label fw-semibold small">Additional Message</label>
                                            <textarea id="appMessage" rows="3" class="form-control form-field"
                                                placeholder="Tell us about any dental symptoms, questions, or preferred times..."></textarea>
                                        </div>

                                        <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                                            <button type="submit" class="btn btn-vimak-red px-4 py-2 flex-grow-1">
                                                <i class="bi bi-whatsapp"></i> REQUEST APPOINTMENT
                                            </button>
                                            <button type="button" id="sendAppointmentEmailBtn" class="btn btn-vimak-outline-dark px-4 py-2">
                                                <i class="bi bi-envelope"></i> SEND VIA EMAIL
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <div id="appointmentFormFeedback" class="d-none"></div>
                            </div>
                        </div>

