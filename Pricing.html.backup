            <!-- How Dental Care & Treatment Pricing Works -->
            <section class="container py-5">
                <div class="text-center mb-5">
                    <span class="section-tag">Transparent Care Planning</span>
                    <h2 class="fw-bold">Dental Consultations &amp; Treatment Estimates</h2>
                    <p class="section-subtitle">
                        Because every patient's dental condition is unique, treatment fees depend on a clinical examination. Contact Vimak Dental Centre directly for current consultation and procedure pricing.
                    </p>
                </div>

                <div class="row g-4">

                    <!-- Care Card 1: Preventive & Routine Visits -->
                    <div class="col-md-4">
                        <div class="price-card">
                            <div class="service-icon-wrap">
                                <i class="fa-solid fa-tooth"></i>
                            </div>
                            <h5 class="fw-bold">Preventive &amp; Routine Care</h5>
                            <p class="text-muted small">Check-ups, oral hygiene &amp; children's dentistry</p>

                            <div class="my-2">
                                <span class="client-confirm-tag"><i class="bi bi-info-circle"></i> Contact Clinic for Current Rates</span>
                            </div>

                            <ul class="price-list">
                                <li><i class="bi bi-check-circle-fill"></i> Comprehensive dental examination</li>
                                <li><i class="bi bi-check-circle-fill"></i> Full-mouth scaling &amp; polishing</li>
                                <li><i class="bi bi-check-circle-fill"></i> Topical fluoride &amp; fissure sealants</li>
                                <li><i class="bi bi-check-circle-fill"></i> Paediatric dental check-ups</li>
                            </ul>

                            <a href="#book-appointment" class="btn price-btn">Book Preventive Visit</a>
                        </div>
                    </div>

                    <!-- Care Card 2: Restorative & Endodontic Care -->
                    <div class="col-md-4">
                        <div class="price-card popular">
                            <span class="badge-popular">Individual Assessment</span>

                            <div class="service-icon-wrap">
                                <i class="bi bi-shield-plus"></i>
                            </div>
                            <h5 class="fw-bold">Restorative &amp; Root Canal Care</h5>
                            <p class="text-muted small">Tooth preservation, fillings &amp; crowns</p>

                            <div class="my-2">
                                <span class="client-confirm-tag"><i class="bi bi-info-circle"></i> Priced Following Clinical Exam</span>
                            </div>

                            <ul class="price-list">
                                <li><i class="bi bi-check-circle-fill"></i> Tooth fillings &amp; restorations</li>
                                <li><i class="bi bi-check-circle-fill"></i> Root canal treatment (endodontics)</li>
                                <li><i class="bi bi-check-circle-fill"></i> Dental crowns, bridges &amp; dentures</li>
                                <li><i class="bi bi-check-circle-fill"></i> Simple extractions &amp; disimpactions</li>
                            </ul>

                            <a href="#book-appointment" class="btn price-btn">Request Restorative Consultation</a>
                        </div>
                    </div>

                    <!-- Care Card 3: Orthodontics, Implants & Aesthetic Care -->
                    <div class="col-md-4">
                        <div class="price-card">
                            <div class="service-icon-wrap">
                                <i class="bi bi-stars"></i>
                            </div>
                            <h5 class="fw-bold">Specialized &amp; Orthodontic Care</h5>
                            <p class="text-muted small">Braces, dental implants &amp; smile care</p>

                            <div class="my-2">
                                <span class="client-confirm-tag"><i class="bi bi-info-circle"></i> Tailored Treatment Quotation</span>
                            </div>

                            <ul class="price-list">
                                <li><i class="bi bi-check-circle-fill"></i> Orthodontics (braces alignment)</li>
                                <li><i class="bi bi-check-circle-fill"></i> Dental implant evaluations</li>
                                <li><i class="bi bi-check-circle-fill"></i> Aesthetic / cosmetic consultations</li>
                                <li><i class="bi bi-check-circle-fill"></i> Step-by-step treatment plan review</li>
                            </ul>

                            <a href="https://wa.me/254720285819?text=Hello%20Vimak%20Dental%20Centre%2C%20I%20would%20like%20to%20inquire%20about%20consultation%20and%20treatment%20pricing."
